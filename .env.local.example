# Firebase web config.
#
# Copy this file to `.env.local` and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app.
#
# `.env.local` is git-ignored, so the values never land in the source repo.
# They are still public once the site is built (Firebase web config is public
# by design), so protect your data with Firestore Security Rules and API key
# restrictions - see README.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Realtime Database URL (Firebase console -> Realtime Database).
# Leave blank to use the default us-central1 host for the project id.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- AI Professor (optional) -------------------------------------------------
# Gemini API key for the AI Professor. Leave blank to use the built-in
# question bank instead. NOTE: on a static host (GitHub Pages) this value is
# baked into the public bundle, so only use a RESTRICTED key there.
NEXT_PUBLIC_GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash).
NEXT_PUBLIC_GEMINI_MODEL=
