{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email === 'brivora@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'brivora@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'brivora@gmail.com')",
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'email'])"
      }
    },
    "enquiries": {
      ".read": "auth != null && auth.token.email === 'brivora@gmail.com'",
      "$id": {
        ".write": "auth != null && auth.token.email === 'brivora@gmail.com' ? true : !data.exists()",
        ".validate": "!newData.exists() || (newData.hasChildren(['name', 'email', 'message']) && newData.child('name').isString() && newData.child('name').val().length <= 200 && newData.child('email').isString() && newData.child('email').val().length <= 320 && newData.child('message').isString() && newData.child('message').val().length <= 5000)"
      }
    },
    "courses": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'brivora@gmail.com'",
      "$id": {
        ".validate": "!newData.exists() || (newData.hasChildren(['title']) && newData.child('title').isString())"
      }
    },
    "payments": {
      ".read": "auth != null && auth.token.email === 'brivora@gmail.com'",
      "$id": {
        ".write": "auth != null && (auth.token.email === 'brivora@gmail.com' || !data.exists())",
        ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'courseTitle', 'amount', 'utr']) && newData.child('amount').isNumber() && newData.child('utr').isString() && newData.child('utr').val().length <= 20)"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'brivora@gmail.com'"
    }
  }
}