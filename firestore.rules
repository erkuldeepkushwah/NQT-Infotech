rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- admins
    // Admin access is by email address. Add or remove addresses here AND in
    // lib/admin.ts (the UI reads that list, the database enforces this one).
    //
    // A verified email is deliberately NOT required - the address is taken from
    // the sign-in token, which carries it either way.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['brivora@gmail.com'];
    }

    // ------------------------------------------------------------- enquiries
    // Contact form submissions: anyone may create one, only admins can read.
    match /enquiries/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'company', 'message', 'createdAt']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.email.size() <= 320
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------- users
    // A signed-in user owns their own profile document and may create it once.
    match /users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['name', 'email', 'role', 'status', 'createdAt']
        )
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active';

      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());

      allow update, delete: if isAdmin();
    }

    // --------------------------------------------------------------- courses
    // Course catalogue: public to read, admins write.
    match /courses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------- payments
    // Students submit their own payment requests; only admins see everyone's.
    match /payments/{docId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
