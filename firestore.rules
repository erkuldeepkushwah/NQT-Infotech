rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contact form submissions.
    //
    // Anyone may create a new enquiry - that is what a public contact form
    // does. Nobody can read, edit or delete them from the browser; read them
    // in the Firebase console (or with the Admin SDK).
    match /enquiries/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'company', 'message', 'createdAt']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.email.size() <= 320
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
